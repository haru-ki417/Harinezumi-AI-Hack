{
  "name": "stealth-vital-web",
  "version": "0.3.0",
  "private": true,
  "scripts": {
    "dev": "next dev --port 3001",
    "build": "next build",
    "start": "next start",
    "build:shared": "powershell.exe -NoProfile -ExecutionPolicy Bypass -File ../Build-SharedInterview.ps1",
    "update:shared": "powershell.exe -NoProfile -ExecutionPolicy Bypass -File ../Update-SharedInterview.ps1",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "test:e2e": "playwright test",
    "test:chat": "playwright test --config=playwright.chat.config.ts",
    "test:report": "playwright test --config=playwright.report.config.ts",
    "test:hiring": "playwright test --config=playwright.hiring.config.ts"
  },
  "dependencies": {
    "@mediapipe/tasks-vision": "0.10.35",
    "next": "^14.2.15",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@types/node": "^20.14.0",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "eslint": "^8.57.0",
    "eslint-config-next": "^14.2.15",
    "typescript": "^5.5.4"
  }
}
